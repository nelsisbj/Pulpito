# Servidor
PORT=4000
# Configure no PostgreSQL local ou use o DATABASE_URL fornecido pelo Render.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# Defina um segredo aleatório e estável para as sessões JWT.
# JWT_SECRET=gere-um-segredo-longo-e-aleatorio
# HOST=0.0.0.0   # expõe o servidor na rede local
# PULPITO_PUBLIC_URL=https://sermoes.seudominio.com
# PULPITO_ALLOW_REMOTE_EDIT=1   # necessário para abrir o app hospedado fora do servidor
# DEFAULT_TRANSLATION=ARA

# Busca de música (opcional — links e som ambiente funcionam sem isso)
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Cópia de segurança em PDF
# PULPITO_AUTO_PDF=0
# PULPITO_PDF_INTERVAL_MS=180000
# PULPITO_PDF_DELAY_MS=12000
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
